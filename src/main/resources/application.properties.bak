spring.application.name=api-ms-appreforma
server.port=${PORT:8081}

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.instance.instance-id=${spring.application.name}:${random.value}

#spring.datasource.url=jdbc:postgresql://192.168.0.61:5432/appReforma
spring.datasource.url=jdbc:postgresql://localhost:54322/appReforma
spring.datasource.username=sistema
spring.datasource.password=11073026
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
#spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQL81Dialect
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

spring.jackson.serialization.fail-on-empty-beans=false

#DEBEMOS AGREGAR O QUITAR LA SIGUIENTE INSTRUCCION PARA LA MIGRACION DE DATOS EN LA BD
spring.flyway.baselineOnMigrate = true